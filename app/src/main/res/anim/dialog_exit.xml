<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogs leave even quicker: a short fade with a slight shrink, ~90ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic"
    android:shareInterpolator="true">
    <scale
        android:duration="90"
        android:fromXScale="1.0" android:toXScale="0.96"
        android:fromYScale="1.0" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="90" android:fromAlpha="1.0" android:toAlpha="0.0" />
</set>
