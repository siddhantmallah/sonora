<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogs pop in quickly: a small scale-up with a fade, ~130ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <scale
        android:duration="130"
        android:fromXScale="0.92" android:toXScale="1.0"
        android:fromYScale="0.92" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="110" android:fromAlpha="0.0" android:toAlpha="1.0" />
</set>
