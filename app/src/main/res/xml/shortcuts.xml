<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the Sonora icon. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="lyrics"
        android:enabled="true"
        android:icon="@drawable/sc_lyrics"
        android:shortcutShortLabel="@string/sc_lyrics"
        android:shortcutLongLabel="@string/sc_lyrics_long">
        <intent
            android:action="com.sonora.player.SHORTCUT"
            android:targetPackage="com.sonora.player"
            android:targetClass="com.sonora.player.ui.MainActivity">
            <extra android:name="target" android:value="lyrics" />
        </intent>
    </shortcut>
